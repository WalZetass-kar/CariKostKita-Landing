NEXT_PUBLIC_CARIKOSTKITA_API_URL=https://carikostkitafastapi.vercel.app

# Admin dashboard BFF (used as a fallback mirror when FastAPI is unreachable).
ADMIN_GUE_API_URL=https://admin-carikostkita.vercel.app

# Realtime push (OPTIONAL).
# When these are absent the landing page fetches the browser-safe `anon`
# credentials from /api/settings/realtime at runtime, so the push path keeps
# working without any build-time configuration. Set them only if you want to
# pin the credentials at build time.
# Public anon key only - NEVER service-role.
NEXT_PUBLIC_SUPABASE_URL=https://gtnsmljlztypqefhojjn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local mirror of Admin-Gue/data/db.json for development only.
# It is never read in production, and it must never override the database.
# ADMIN_GUE_LOCAL_DB_PATH=../Admin-Gue/data/db.json
